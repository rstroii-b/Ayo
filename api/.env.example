DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=saveurs
DB_USER=root
DB_PASS=

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://localhost:5500

# Stripe — clés de test depuis https://dashboard.stripe.com/test/apikeys
# Connect doit être activé sur le compte avant d'utiliser les endpoints /connect/*
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DISPATCH_COMMISSION_PCT=15

# CinetPay — paiement mobile money pour la zone XOF (Abidjan) uniquement.
# Laisser vide désactive proprement le paiement XOF (503) sans casser Stripe/EUR.
# Identifiants depuis https://app.cinetpay.com (menu Intégrations > Clé API)
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_ENV=sandbox
CINETPAY_COUNTRY=CI

# URLs utilisées pour construire les liens de retour CinetPay (success/failed/notify).
FRONT_URL=https://ayo.jobivoire.com
API_URL=https://api-ayo.jobivoire.com

# Notifications push — générer avec Minishlink\WebPush\VAPID::createVapidKeys()
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Temps réel — dashboard.pusher.com (plan gratuit largement suffisant)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
