{
  "name": "saveurs/api",
  "description": "API REST de la plateforme Saveurs",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "firebase/php-jwt": "^7.1",
    "vlucas/phpdotenv": "^5.6",
    "stripe/stripe-php": "^21.2",
    "minishlink/web-push": "^11.0",
    "guzzlehttp/guzzle": "^7.8 || ^8.0",
    "pusher/pusher-php-server": "^7.3",
    "lbuchs/webauthn": "^2.2",
    "cinetpay-dev/cinetpay-php": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Saveurs\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
